# Patterns below have no leading slash, so they apply at every project depth.

build/
bin/
work/
.venv/
compile_commands.json
__pycache__/

# Downloaded datasets and generated sample inputs.
data/
inputs/

# Trained weights are regenerated by the project's training script; the
# accompanying config files are source and stay tracked.
models/*
!models/*.yaml

*.obj
*.o
*.a
*.exe
*.oien
